pipeline {
    agent {
        label "worker"
    }

    tools {
        maven 'maven'
    }

    stages {

        stage('Checkout') {
            steps {
                git 'https://github.com/anjalikumbhar372/student-management.git'
                echo "Cloning is Successful"
            }
        }

        stage('Build') {
            steps {
                sh '''
                    mvn clean package
                '''
            }

            post {
                success {
                    archiveArtifacts artifacts: '**/target/*.war', fingerprint: true
                }
            }
        }
        
        stage ('Artifacts to s3') {
            steps {
                sh 'aws s3 cp target/*.war s3*://mayurcbz.space/Artifacts/student.war'
            }
        }

        stage('SonarQube Analysis'){
            steps {
                withSonarQubeEnv('sonar') {
                    sh 'mvn sonar:sonar'
                }
            }
        }
    }
             
}