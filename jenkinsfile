pipeline {
    agent {
        label "worker"
    }

    tools {
        maven 'maven'
    }

    stages {

        stage('checkout'){
            steps{
                git 'https://github.com/anjalikumbhar372/student-management.git'
                echo "Clonning is Successful"            }
        }
    }

        stage('Build') {
            steps {
                sh '''
                    maven clean package
                '''
        }
            post {
                success {
                    archiveArtifacts artifacts: '**/target/*.war', fingerprint: true
            }
        }
    }
}

