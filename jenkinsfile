pipeline {
    agent {
        label "worker"
    }

    tools {
        maven 'maven'

    }

    environment {
        my_aws_cred == creditionals('aws-cred')
    }

    stages { 
        stage ('checkout'){
            steps {
                git 'https://github.com/mayurpandit25/student-management.git'
                echo "Clonning is successful"
            }
           
        }

        stage ('Build'){
            steps {
                sh '''
                    mvn clean package
                    '''
            }

            post {
                success {
                    archiveAetifacts artifacts: '**/target/*.war', fingerprint: true
                }
            }
        }

        stage ('Artifacts to s3') {
            steps {
                sh 'aws s3 cp target/*.war s3://mayurcbz.space.123/Artifacts/student.war'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonar'){
                    sh 'mvn sonar:sonar'
                }
            }
        }

        stage('Quality Gates') {
            steps {
                timeout(time: 5, unit: 'MINUTES'){
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker Build'){
            steps{
                sh '''
                    docker build --no-cache -t student .
                    docker images
            }   '''
        }

        stage('Push to ECR'){
            steps{
                sh '''
                aws ecr get-login-password --region ap-south-1 | docker login --username AWS --password-stdin 823787500858.dkr.ecr.ap-south-1.amazonaws.com
                docker tag student:latest 823787500858.dkr.ecr.ap-south-1.amazonaws.com/student:latest
                docker push 823787500858.dkr.ecr.ap-south-1.amazonaws.com/student:latest
                '''
            }      
        }

        stage('Deployment on Kubernetes'){
            steps{
                sh '''
                 aws eks update-kubeconfig --name my-eks-cluster --region ap-south-1
                    kubectl apply -f k8s/
                    kubectl get pods
                    sleep 30
                    kubectl get pods
                    kubectl  get svc -o wide
                    '''
            }
        }
        
    }
    
}